# Required in production (use a long random string)
SESSION_SECRET=
# Public address of the site, used in email links (optional behind a proxy)
APP_URL=https://example.edu
# Where members.xlsx, accounts.json live. Point MEMBERS_XLSX_PATH at a shared folder if you want.
DATA_DIR=./data
# MEMBERS_XLSX_PATH=/shared/elevation/members.xlsx
# Staff who may download the member Excel (for example Niko and Ibrahim)
STAFF_EMAILS=niko@example.edu,ibrahim@example.edu
# Email (optional). Without SMTP_HOST, emails are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Elevation Center <no-reply@example.edu>
